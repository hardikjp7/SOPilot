# Copy to .env locally. Never commit a populated .env.
LLM_KEY=Your-LLM-key-here
LLM_BASE_URL=Your-LLM-base-url-here
TLS_VERIFY=false
MODEL_MAIN=genailab-maas-gpt-5.4
MODEL_FAST=genailab-maas-gpt-5.4-mini
MODEL_FALLBACK=azure/genailab-maas-gpt-4.1
MODEL_EMBED=azure/genailab-maas-text-embedding-3-large
EMBED_BATCH_SIZE=32
MOCK=0
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.35
RETRIEVAL_MIN_MARGIN=0.03
HYBRID_WEIGHT_SEMANTIC=0.7
BM25_K1=1.5
BM25_B=0.75
BM25_SCORE_SCALE=8.0
SEMANTIC_SIMILARITY_FLOOR=0.3
PARSE_MIN_CONFIDENCE=0.5
PARSE_CACHE_SIZE=128
MIN_VERIFIED_STEPS=3
REDACT_IPS=false
MAX_REQUEST_BYTES=204800
# Optional runtime storage override; defaults to this repository's data/.
# DATA_DIR=/absolute/path/to/runtime-data